@page "/"
@using Services
@using System.Threading.Tasks
@using ViewModels
@inject HomePageViewModel HomePageViewModel

<PageTitle>DeMarks Website</PageTitle>

@if (HomePageViewModel.IsLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="home-container" style="background-image: url('@this.HomePageViewModel.DisplayRandomExpidition40Image()');">
        <h1 class="title-and-description">Andrew DeMarco</h1>
        <p class="title-and-description">Software Engineer | Space Enthusiast | Lifelong Learner</p>
    </div>
}

@code {
    protected override async Task OnInitializedAsync() 
    {
        await this.HomePageViewModel.LoadAsync();
    }
}


